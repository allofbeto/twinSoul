{
  // Cloudflare Workers Builds: serves the built React app (frontend/build) as static assets.
  // The Rails API is NOT hosted here — point the build at it with REACT_APP_API_URL (see README).
  "name": "tttools",
  "compatibility_date": "2026-10-01",
  // Builds the React app before reading frontend/build. (The root postinstall script also builds
  // it on Cloudflare; --if-missing makes this a no-op when that already ran.)
  "build": { "command": "node scripts/build-frontend.js --if-missing" },
  "assets": {
    "directory": "./frontend/build",
    // Deep links like /dashboard/sessions/123 fall back to index.html so React Router can handle them.
    "not_found_handling": "single-page-application"
  }
}
